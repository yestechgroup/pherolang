{
  "formatVersion": 1,
  "comment": "Generated by pherolang from the phero-highlight surface metadata; do not edit. Regenerate with `pherolang grammar --out site/packages/highlighting`.",
  "name": "rosetta",
  "scopeName": "source.rosetta",
  "fileTypes": [
    ".rosetta"
  ],
  "aliases": [
    "rosetta"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#escapedIdentifiers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#contextualWords"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#typeNames"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.pherolang",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.pherolang",
          "match": "///[^\\n]*"
        },
        {
          "name": "comment.pherolang",
          "match": "//[^\\n]*"
        },
        {
          "name": "comment.pherolang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "contextualWords": {
      "patterns": [
        {
          "match": "^[\\t ]*((?:structured_provision|rationale_author|reportedField|ruleReference|docReference|displayName|eligibility|annotation|projection|recordType|basicType|condition|isProduct|namespace|provision|rationale|reporting|typeAlias|contains|disjoint|distinct|function|metaType|multiple|optional|override|required|default|extends|extract|flatten|isEvent|library|reverse|segment|version|absent|choice|corpus|enrich|exists|filter|import|ingest|inputs|output|prefix|reduce|report|schema|single|source|switch|ASATP|False|alias|count|empty|first|label|scope|True|body|else|enum|from|func|item|join|last|only|root|rule|sort|then|type|when|with|add|all|and|any|for|max|min|set|sum|as|if|in|is|or))\\b",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^[\\t ]*(recordType)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(basicType)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(namespace)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.namespace.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(typeAlias)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(metaType)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(choice)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(enum)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(func)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.function.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(rule)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.function.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(type)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        }
      ]
    },
    "escapedIdentifiers": {
      "patterns": [
        {
          "name": "entity.name.type.pherolang",
          "match": "\\^[A-Z][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.pherolang",
          "match": "\\^[a-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.pherolang",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pherolang",
          "match": "\\b(?:to\\-zoned\\-date\\-time|post\\-condition|only\\-element|to\\-date\\-time|real\\-time|to\\-number|to\\-string|with\\-meta|to\\-date|to\\-enum|to\\-time|as\\-key|one\\-of|to\\-int)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.pherolang",
          "match": "\\b(?:False|True)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pherolang",
          "match": "[0-9]*\\.?[0-9]+(?:[eE][+-]?[0-9]+)?"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pherolang",
          "match": "(?:->|=>|==|!=|<=|>=|~=|!~|&&|\\|\\||[=+\\-*/%<>!&|^~?])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.pherolang",
          "match": "[{}()\\[\\],.;:]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pherolang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pherolang",
              "match": "\\\\u[0-9A-Fa-f]{4}"
            },
            {
              "name": "constant.character.escape.pherolang",
              "match": "\\\\[\\s\\S]"
            }
          ]
        },
        {
          "name": "string.quoted.double.pherolang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pherolang",
              "match": "\\\\[\\s\\S]"
            }
          ]
        }
      ]
    },
    "typeNames": {
      "patterns": [
        {
          "name": "entity.name.type.pherolang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
