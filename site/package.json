{
  "name": "pherolang-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r run check",
    "dev": "pnpm -r --parallel dev",
    "fetch-pherolang": "node scripts/fetch-pherolang.mjs",
    "sync-model": "node scripts/sync-model.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:links": "node scripts/gate.mjs --only=links",
    "gate:a11y": "node scripts/gate.mjs --only=a11y",
    "check:commands": "node scripts/check-commands.mjs",
    "check:grammars": "node scripts/check-grammars.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "html-validate": "^11.21.1",
    "playwright": "^1.65.1",
    "shiki": "^4.6.0"
  }
}
