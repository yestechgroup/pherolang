---
interface Props {
  label?: string;
  tone?: 'neutral' | 'accent' | 'outline';
}
const { label, tone = 'neutral' } = Astro.props;
const tones = {
  neutral: 'bg-[color-mix(in_oklab,var(--border)_60%,transparent)] text-[var(--text-muted)]',
  accent: 'bg-lime text-graphite',
  outline: 'border border-[var(--border)] text-[var(--text-muted)]',
};
---
<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-xs px-2 py-0.5 font-mono text-xs font-medium uppercase tracking-[0.1em]',
    tones[tone],
  ]}
>
  <slot>{label}</slot>
</span>
