{
  "formatVersion": 1,
  "comment": "Generated by pherolang from the phero-highlight nine-surface metadata; do not edit. Regenerate with `pherolang grammar --out site/packages/highlighting`.",
  "name": "mox",
  "scopeName": "source.mox",
  "fileTypes": [
    ".mox"
  ],
  "aliases": [
    "mox"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#escapedIdentifiers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#contextualWords"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtinTypes"
    },
    {
      "include": "#typeNames"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.pherolang",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "builtinTypes": {
      "patterns": [
        {
          "name": "support.type.pherolang",
          "match": "\\b(?:DateTime|Boolean|Decimal|Instant|boolean|Double|String|double|string|Float|Short|bytes|float|short|Blob|Byte|Char|Long|Uuid|byte|char|date|long|Int|int)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.pherolang",
          "match": "///[^\\n]*"
        },
        {
          "name": "comment.block.documentation.pherolang",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/"
        },
        {
          "name": "comment.pherolang",
          "match": "//[^\\n]*"
        },
        {
          "name": "comment.pherolang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "contextualWords": {
      "patterns": [
        {
          "match": "^[\\t ]*((?:maxLength|minLength|readonly|register|convert|maximum|minimum|pattern|create|format|schema|unique|sigil|table|set|id|to))\\b",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^[\\t ]*(vocabulary)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(interface)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(register)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(package)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.namespace.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(actors)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.namespace.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(class)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(enum)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(type)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        }
      ]
    },
    "escapedIdentifiers": {
      "patterns": [
        {
          "name": "entity.name.type.pherolang",
          "match": "\\^[A-Z][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.pherolang",
          "match": "\\^[a-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.pherolang",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pherolang",
          "match": "\\b(?:subscription|annotation|capability|delegation|never_both|obligation|vocabulary|container|interface|publishes|contains|opposite|channel|derived|extends|package|purpose|version|actors|forbid|import|opaque|permit|refers|actor|agent|cedar|class|event|facet|false|grant|wraps|enum|from|true|type|when|key|as|on|op)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.pherolang",
          "match": "\\b(?:false|true)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pherolang",
          "match": "-?[0-9]+"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pherolang",
          "match": "(?:->|=>|==|!=|<=|>=|~=|!~|&&|\\|\\||[=+\\-*/%<>!&|^~?])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.pherolang",
          "match": "[{}()\\[\\],.;:]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pherolang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pherolang",
              "match": "\\\\u[0-9A-Fa-f]{4}"
            },
            {
              "name": "constant.character.escape.pherolang",
              "match": "\\\\[\\s\\S]"
            }
          ]
        }
      ]
    },
    "typeNames": {
      "patterns": [
        {
          "name": "entity.name.type.pherolang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
