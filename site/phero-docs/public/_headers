# docs.pherolang.com — response headers for the Cloudflare Worker's static
# assets. Same format and same traps as `site/phero-web/public/_headers`:
#
#   * a request matching several rules inherits the headers of EVERY matching
#     rule, and a header set twice is joined with a comma — so `Cache-Control`
#     is set once per response, which is why the `/_astro/*` rule detaches the
#     broader value before setting its own;
#   * `! Name` removes only what EARLIER rules added, so the narrower rule has
#     to come after the broader one;
#   * `_headers` applies to asset responses only. Both apps deploy as
#     assets-only Workers, so every response a visitor sees passes through this
#     file.
#
# The Content-Security-Policy is derived from the built HTML, not from theory.
# Starlight emits inline scripts and inline `style` attributes, and Pagefind's
# search worker instantiates WebAssembly, so this app needs two relaxations the
# marketing app does not. `site/DEPLOY.md` names both and the evidence behind
# them.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build output (`index.<hash>.css`, `<island>.<hash>.js`): the filename
# changes when the bytes change, so it can be cached forever. The detach keeps
# the `/*` rule from joining a second, contradictory max-age onto the value.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Pagefind's index and fragment files carry a content hash in the name
# (`en_6ed0f2c.pf_fragment`), so they are immutable too. `pagefind.js`,
# `pagefind-ui.js` and the CSS keep their names across deploys and therefore
# stay on the revalidating `/*` rule above.
/pagefind/index/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/pagefind/fragment/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Version-preview and workers.dev hostnames are not canonical. Preview URLs look
# like `<version>-<worker>.<account-subdomain>.workers.dev`, which is the
# placeholder shape Cloudflare documents for this file (one splat per rule is
# the limit, and a hostname wildcard plus a path wildcard is two).
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
