---
import Base from '../layouts/Base.astro';
import SectionHeader from '@ui/SectionHeader.astro';
import Prose from '@ui/Prose.astro';
import Callout from '@ui/Callout.astro';
import CodeBlock from '@ui/CodeBlock.astro';
import Button from '@ui/Button.astro';
import commands from '../data/commands.json';

/**
 * Every shell string on this page is read from `src/data/commands.json`, the
 * file `site/scripts/check-commands.mjs` executes. A command cannot be printed
 * without existing in that list, and `command()` throws at build time if an id
 * is misspelt. Entries marked `network: true` are download steps; the gate
 * skips them because they need the release archive.
 *
 * The installation *prose* is not restated here: `docs/INSTALL.md` is the one
 * normative install guide (#236 G1-09), and this page is its summary plus the
 * verify-your-install commands the executor can run.
 */
interface Command {
  id: string;
  label: string;
  run: string;
  expectExit?: number;
  expectStdout?: string;
  network?: boolean;
}
const all: Command[] = commands.commands;

function command(id: string): Command {
  const found = all.find((entry) => entry.id === id);
  if (!found) throw new Error(`commands.json has no command '${id}'`);
  return found;
}
const shell = (...ids: string[]) => ids.map((id) => command(id).run).join('\n');
const prints = (id: string) => command(id).expectStdout ?? '';

const repo = 'https://github.com/yestechgroup/pherolang';
const releases = `${repo}/releases`;
const docs = 'https://docs.pherolang.com';
const installGuide = `${docs}/reference/install/`;
const editorsGuide = `${docs}/reference/editors/`;
---

<Base
  title="Install Phero Lang"
  description="Install the pherolang compiler from a released binary, or build it from source with cargo."
>
  <div class="py-16 sm:py-24">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--text-muted)]">Install</p>
    <h1 class="mt-6 max-w-[24ch] font-display text-display-2 font-semibold text-balance">
      One binary, in one command.
    </h1>
    <p class="mt-5 max-w-[62ch] text-lg leading-[1.6] text-[var(--text-muted)] text-pretty">
      <code class="font-mono text-[0.9em]">pherolang</code> is a native executable. It runs no
      service, needs no account, and reads nothing from the network while it compiles.
    </p>
    <p class="mt-6">
      <a
        class="text-[var(--link)] underline decoration-[color-mix(in_oklab,var(--link)_45%,transparent)] underline-offset-4 hover:decoration-[var(--link)]"
        href={`${releases}/tag/v0.4.0`}
        rel="noopener">Browse the v0.4.0 release on GitHub</a
      >.
    </p>

    <section id="install" class="mt-16">
      <SectionHeader
        eyebrow="Summary"
        title="Two supported paths"
        lede="Both are documented, command by command, in the normative install guide — this page is the short version."
      />

      <Prose class="mt-8 max-w-[68ch]">
        <p>
          <strong>From a release.</strong> Download
          <code>pherolang-0.4.0-x86_64-unknown-linux-gnu.tar.gz</code> and <code>SHA256SUMS</code>,
          verify with <code>sha256sum -c</code>, and move the single binary onto your <code>PATH</code>
          — <code>/usr/local/bin</code> with <code>sudo</code>, or <code>~/.local/bin</code> without.
          Upgrading is the same commands for the new tag; uninstalling is <code>rm</code>. The full
          sequence lives at <a href={installGuide} rel="noopener">docs.pherolang.com/reference/install</a>.
        </p>
        <p>
          <strong>From source.</strong> With a Rust toolchain:
          <code>cargo install --git https://github.com/yestechgroup/pherolang --tag v0.4.0 --locked phero-cli</code>
          — minutes to compile, no checksum step, same <code>--version</code> banner. The crates are
          deliberately not on crates.io before 1.0 (<a
            href={`${repo}/blob/main/docs/VERSIONING.md`} rel="noopener">VERSIONING.md</a
          > owns that decision).
        </p>
      </Prose>

      <Callout tone="warning" title="Only Linux x86_64 is supported">
        <p>
          Phero Lang supports <code>x86_64-unknown-linux-gnu</code> (glibc) only. No
          <code>aarch64</code>, <code>apple-darwin</code>, or <code>pc-windows</code> archive is
          built or published, and no CI job runs the binary there — aarch64, macOS and Windows are
          unsupported and untested. On those platforms <code>cargo install</code> compiles natively
          and may work, but that is not a support claim. The reasoning is in
          <a
            href={`${repo}/blob/main/docs/adr/0004-supported-platforms-linux-only.md`}
            rel="noopener">the supported-platforms ADR</a
          >.
        </p>
      </Callout>
    </section>

    <section id="verify" class="mt-20">
      <SectionHeader
        eyebrow="Step 2"
        title="Verify the install"
        lede="Two commands that need no model files, then one that does."
      />

      <CodeBlock lang="sh" filename="bash" runnable code={shell('version')} />
      <Prose class="mt-4">
        <p>
          It prints <code>{prints('version')}</code> followed by the target triple it was built for —
          <code>pherolang 0.4.0 (x86_64-unknown-linux-gnu)</code> for the Linux x86_64 archive. The
          triple is part of the banner so a bug report can name the platform.
        </p>
      </Prose>

      <Prose class="mt-8">
        <p>
          The registry that explains the compiler's diagnostic codes ships inside the binary — so this
          works from an empty directory:
        </p>
      </Prose>
      <CodeBlock lang="sh" filename="bash" runnable code={shell('explain')} />
      <Prose class="mt-4">
        <p>
          You should see <code>E0104 — Unknown action reference (error)</code>, the band it belongs
          to, the meaning, and a one-line fix. <code>pherolang explain --list</code> prints the whole
          allocation ledger.
        </p>
      </Prose>

      <Prose class="mt-8">
        <p>
          To check a real model, clone the repository and run the compiler over the example it uses
          everywhere:
        </p>
      </Prose>
      <CodeBlock lang="sh" filename="bash" runnable code={shell('check')} />
      <Prose class="mt-4">
        <p>
          It prints <code>{prints('check')}</code> and exits <code>0</code>. From here,
          <a href="/getting-started">the five-minute walkthrough</a> compiles that model to an
          artifact and generates code from it.
        </p>
      </Prose>
    </section>

    <section id="editors" class="mt-20">
      <SectionHeader
        eyebrow="Editors"
        title="The language server"
        lede="The same binary is the language server. There is no editor extension in this repository, so you point your client at the executable."
      />

      <CodeBlock lang="sh" filename="bash" runnable code={shell('lsp')} />

      <Prose class="mt-6">
        <p>
          <code>pherolang lsp</code> speaks LSP over stdio and exits when the client closes the
          stream — which is why this page can print it as a command that terminates. It serves all
          nine surfaces with hover, go-to-definition, references, rename, completions, formatting,
          document symbols, and semantic tokens. Client setups for Neovim, VS Code, and Zed — the
          untested ones marked as such — live at
          <a href={editorsGuide} rel="noopener">docs.pherolang.com/reference/editors</a>.
        </p>
      </Prose>

      <Callout title="Next">
        <p>
          The walkthrough compiles a real model and generates code from it:
          <Button href="/getting-started" variant="primary" class="mt-3">Get started</Button>
        </p>
      </Callout>
    </section>
  </div>
</Base>
