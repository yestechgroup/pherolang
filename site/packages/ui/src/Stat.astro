---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---
<div class="border-l border-[var(--border)] pl-4">
  <p class="font-display text-2xl font-semibold tabular-nums text-[var(--text)]">{value}</p>
  <p class="mt-1 font-mono text-xs uppercase tracking-[0.14em] text-[var(--text-muted)]">{label}</p>
</div>
