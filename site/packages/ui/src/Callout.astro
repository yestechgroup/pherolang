---
interface Props {
  tone?: 'note' | 'warning';
  title?: string;
}
const { tone = 'note', title } = Astro.props;
const accent = tone === 'warning' ? 'var(--color-deep-blue)' : 'var(--color-lime)';
---
<aside
  class="my-6 rounded-md border border-[var(--border)] bg-[var(--surface-raised)] p-4 pl-5"
  style={`border-left: 3px solid ${accent};`}
>
  {title && <p class="mb-1 font-mono text-xs uppercase tracking-[0.14em] text-[var(--text-muted)]">{title}</p>}
  <div class="text-[0.9375rem] leading-[1.6] text-[var(--text)]"><slot /></div>
</aside>
