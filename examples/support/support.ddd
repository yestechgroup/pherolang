// Support-desk application design over support.mox, tied by name to the
// support.actor capabilities: the desk module designs the ticket queue
// (entity with a scaffolded repository, an immutable refund decision, and a
// full-text search projection) plus its transport boundaries — a standalone
// input DTO and a projected read-side summary — while the people module
// mirrors the user register as a read-side DTO.
import "support.mox";

application SupportDesk {
    base nz.example.support
    module desk {
        /// Triages and resolves support tickets.
        service TicketService {
            inject TicketRepository;
            inject TicketSearch;
            Ticket raise(NewTicket draft) emits TicketRaised;
            boolean raiseRefund(String ticketNo, int cents) capability RaiseRefund emits RefundRequested;
            boolean approveRefund(String ticketNo, int cents, User approver) capability ApproveRefund emits RefundApproved;
            Ticket[] listTickets();
            Ticket getTicket(String ticketNo);
            TicketSummary summarizeTicket(String ticketNo);
            boolean claimTicket(String ticketNo, User helper);
            boolean refundTicket(String ticketNo, int cents);
            boolean markRead(String ticketNo) capability ReadTicket;
            boolean assign(String ticketNo, User assignee) capability UpdateTicket;
            boolean approve(String ticketNo) capability ResolveTicket;
            boolean reject(String ticketNo) capability UpdateTicket;
            boolean updateTicket(String ticketNo) capability UpdateTicket => TicketRepository {
                let ticket = self.findById(ticketNo) else error NotFound("Ticket", ticketNo);
                guard ticket.state != TicketState.Resolved else error Conflict("already resolved");
                ticket.internal = false;
                let saved = self.save(ticket);
                return true;
            }
            boolean resolveTicket(String ticketNo) capability ResolveTicket emits TicketResolved;
            protected close => TicketRepository.delete;
            findTickets => TicketSearch.search;
        }
        entity Ticket scaffold cache repository TicketRepository {
            findById;
            findAll;
            findByExample;
            findByKeys;
            save;
            delete;
            protected Ticket findByTitle(String title);
        }
        /// One refund decision under strict value semantics: no identity,
        /// deep-immutable, structural equality — so every stored feature of
        /// the class is readonly (R-V1–R-V3).
        value RefundDecision nonPersistent
        /// The transport shape accepted by `raise`: a declared, source-less
        /// boundary (DD3).
        dto NewTicket {
            String title;
            boolean internal;
        }

        /// Read-side ticket summary: a projection, not a domain class.
        dto TicketSummary from Ticket {
            ticketNo;
            title;
            state;
            refundable = refundCents > 0;
        }

        /// Full-text search over the ticket queue.
        search TicketSearch {
            entity Ticket
            text {
                title boost 3
            }
            filters {
                state
                internal
            }
            sort {
                title
            }
            document {
                headline = title;
                refundNote = if refundCents > 0 { "refund pending" } else { "no refund" };
            }
            ranking bm25
            analyzer "english"
            pagination {
                limit 20
                max 100
                cursor
            }
            capability ReadTicket
        }
    }
    module people {
        /// The user register is read through this projection only.
        dto User nonPersistent
    }
}
