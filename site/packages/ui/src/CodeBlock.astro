---
import { findRepoRoot, loadArtifact, lookupEntry } from '../../highlighting/src/artifact.mjs';
import { escapeHtml, renderInlineHtml } from '../../highlighting/src/render.mjs';
import { isPheroSurface } from '../../highlighting/src/taxonomy.mjs';

interface Props {
  code?: string;
  lang?: string;
  filename?: string;
  /** When true the block is executable documentation: scripts/gate.mjs runs it. */
  runnable?: boolean;
}
const { code, lang, filename, runnable = false } = Astro.props;
const body = code ?? '';

// ---------------------------------------------------------------------------
// Compiler-backed highlighting.
//
// A Phero Lang surface is looked up in the committed artifact by the exact
// bytes of `body` (the key is `sha256(surface + "\0" + source)`); the spans are
// rendered as `hl-*` spans. Everything else — and a Phero block with no entry —
// is escaped plaintext. `data-phero-highlight` records which path was taken so
// the site gate can fail on `missing` instead of letting production regress.
//
// `loadArtifact` caches per artifact path, so every block on a page shares one
// parse of `site/data/highlighting/spans.json`.
// ---------------------------------------------------------------------------
const phero = isPheroSurface(lang);
let html: string;
let marker: string | undefined;

if (phero) {
  const { artifact } = loadArtifact(findRepoRoot(process.cwd()));
  const { entry } = lookupEntry(artifact, lang as string, body);
  if (entry) {
    html = renderInlineHtml(body, entry.spans);
    marker = lang;
  } else {
    html = escapeHtml(body);
    marker = 'missing';
  }
} else {
  html = escapeHtml(body);
}
---
<figure class="my-6 overflow-hidden rounded-md border border-[var(--border)] bg-[var(--code-bg)]">
  {(filename || lang) && (
    <figcaption class="flex items-center justify-between border-b border-[var(--border)] px-4 py-2 font-mono text-xs uppercase tracking-[0.12em] text-[var(--text-muted)]">
      <span>{filename ?? lang}</span>
      {runnable && <span class="normal-case tracking-normal">executed by CI</span>}
    </figcaption>
  )}
  <pre
    tabindex="0"
    class="overflow-x-auto p-4 font-mono text-[0.8125rem] leading-[1.65] text-[var(--text)]"
  ><code
      class={lang ? `language-${lang}` : undefined}
      data-runnable={runnable ? '' : undefined}
      data-phero-highlight={marker}
      set:html={html}></code></pre>
</figure>
