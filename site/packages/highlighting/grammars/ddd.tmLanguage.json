{
  "formatVersion": 1,
  "comment": "Generated by pherolang from the phero-highlight nine-surface metadata; do not edit. Regenerate with `pherolang grammar --out site/packages/highlighting`.",
  "name": "ddd",
  "scopeName": "source.ddd",
  "fileTypes": [
    ".ddd"
  ],
  "aliases": [
    "ddd"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#escapedIdentifiers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#contextualWords"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtinTypes"
    },
    {
      "include": "#typeNames"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.pherolang",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "builtinTypes": {
      "patterns": [
        {
          "name": "support.type.pherolang",
          "match": "\\b(?:DateTime|Boolean|Decimal|Instant|boolean|Double|String|double|string|Float|Short|bytes|float|short|Blob|Byte|Char|Long|Uuid|byte|char|date|long|Int|int)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.pherolang",
          "match": "///[^\\n]*"
        },
        {
          "name": "comment.block.documentation.pherolang",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/"
        },
        {
          "name": "comment.pherolang",
          "match": "//[^\\n]*"
        },
        {
          "name": "comment.pherolang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "contextualWords": {
      "patterns": [
        {
          "match": "^[\\t ]*((?:optimisticLocking|findByExample|nonPersistent|application|compatible|findByKeys|pagination|repository|transition|aggregate|auditable|invariant|protected|abstract|analyzer|children|decision|document|findById|scaffold|terminal|filters|findAll|initial|invokes|machine|ranking|service|cursor|custom|delete|entity|extend|inject|module|return|search|throws|boost|cache|emits|error|guard|limit|value|where|base|desc|else|page|root|save|sort|text|asc|dto|let|max|via|if))\\b",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^[\\t ]*(application)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.namespace.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(repository)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(children)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(decision)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.function.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(machine)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(service)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(entity)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(extend)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(module)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.namespace.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(search)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(value)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(base)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.namespace.pherolang"
            }
          }
        },
        {
          "match": "^[\\t ]*(dto)(?:\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pherolang"
            },
            "2": {
              "name": "entity.name.type.pherolang"
            }
          }
        }
      ]
    },
    "escapedIdentifiers": {
      "patterns": [
        {
          "name": "entity.name.type.pherolang",
          "match": "\\^[A-Z][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.pherolang",
          "match": "\\^[a-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.pherolang",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pherolang",
          "match": "\\b(?:capability|version|import|from|when)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.pherolang",
          "match": "\\b(?:exact|false|tfIdf|bm25|true)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pherolang",
          "match": "-?[0-9]+"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pherolang",
          "match": "(?:->|=>|==|!=|<=|>=|~=|!~|&&|\\|\\||[=+\\-*/%<>!&|^~?])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.pherolang",
          "match": "[{}()\\[\\],.;:]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pherolang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pherolang",
              "match": "\\\\u[0-9A-Fa-f]{4}"
            },
            {
              "name": "constant.character.escape.pherolang",
              "match": "\\\\[\\s\\S]"
            }
          ]
        }
      ]
    },
    "typeNames": {
      "patterns": [
        {
          "name": "entity.name.type.pherolang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
